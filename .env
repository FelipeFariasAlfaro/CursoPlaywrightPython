# ══════════════════════════════════════════════════════════════
# CONFIGURACIÓN DEL REPORTE HTML - Behave + Playwright
# ══════════════════════════════════════════════════════════════

# Activar/desactivar la generación del reporte HTML (true/false)
REPORT_ENABLED=true

# Ruta de salida del reporte HTML (relativa al proyecto)
REPORT_OUTPUT_DIR=reports

# Nombre del archivo de reporte generado
REPORT_FILENAME=reporte_pruebas.html

# Ruta donde se guardan los screenshots (relativa al proyecto)
SCREENSHOTS_DIR=reports/screenshots

# Limpiar reportes y screenshots anteriores antes de cada ejecución (true/false)
REPORT_CLEAN_BEFORE_RUN=true

# Capturar screenshot en cada paso (true/false)
SCREENSHOT_ON_EACH_STEP=true

# Capturar screenshot solo en pasos fallidos (true/false) - Si es true, ignora SCREENSHOT_ON_EACH_STEP
SCREENSHOT_ONLY_ON_FAILURE=false

# Abrir el reporte automáticamente al finalizar la ejecución (true/false)
REPORT_OPEN_AFTER_RUN=false
